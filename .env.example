# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Required outside local development
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=botpanel.sid

# Optional storage location for uploaded background media
MEDIA_DIR=./media

# Optional owner bootstrap values for owner.sh
OWNER_USERNAME=admin
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=replace-before-use

# Optional: boot a fake Pterodactyl API on 127.0.0.1:48080 for local development
# PTERODACTYL_DEMO=1
