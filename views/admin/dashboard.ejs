                    />
                    <span class="slider-value" id="glassBlurVal">0px</span>
                  </div>
                  <div class="form-hint">
                    Backdrop-filter blur strength for glass panels
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Border Radius</label>
                  <div class="slider-control">
                    <input
