        // Avatar
        const img = document.getElementById("modalAvatarImg");
        const fallback = document.getElementById("modalAvatarFallback");
        renderAvatar(img, fallback, user.profilePic);

        document.getElementById("modalName").textContent = escapeHtml(
          user.username
        );
        document.getElementById("modalEmail").textContent = escapeHtml(
          user.email || ""
        );
        document.getElementById("modalBadges").innerHTML =
          roleBadge(user.role) + presenceBadge(Boolean(user.online));
        document.getElementById("modalUserId").textContent =
          "#" + escapeHtml(user.id.slice(0, 8));
        document.getElementById("modalLastLogin").textContent = formatDate(
          user.lastLogin?.ts
        );
        document.getElementById("modalJoined").textContent = formatDateOnly(
          user.createdAt
        );

        const savedBio = localStorage.getItem("botpanel_bio_" + user.id);
        document.getElementById("modalBio").textContent =
          user.bio || savedBio || "No bio yet.";

        document.getElementById("memberModal").classList.add("active");
        document.body.style.overflow = "hidden";
      }

      function closeMemberModal(e) {
        if (e && e.target !== e.currentTarget) return;
        document.getElementById("memberModal").classList.remove("active");
        document.body.style.overflow = "";
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMemberModal();
      });

      function validateUserForm() {
        const username = document
          .getElementById("newUserUsername")
          .value.trim();
        const password = document.getElementById("newUserPassword").value;
        let valid = true;

        const usernameInput = document.getElementById("newUserUsername");
        const passwordInput = document.getElementById("newUserPassword");

        if (!username) {
          usernameInput.classList.add("input-error");
          document.getElementById("usernameError").classList.add("visible");
          valid = false;
        } else {
          usernameInput.classList.remove("input-error");
          document.getElementById("usernameError").classList.remove("visible");
        }

        if (!password || password.length < 8) {
          passwordInput.classList.add("input-error");
          document.getElementById("passwordError").classList.add("visible");
          valid = false;
        } else {
          passwordInput.classList.remove("input-error");
          document.getElementById("passwordError").classList.remove("visible");
        }

        return valid ? { username, password } : null;
      }

      async function submitNewUser() {
        const formData = validateUserForm();
        if (!formData) return;
        const roleSelect = document.getElementById("newUserRole");
        if (roleSelect && roleSelect.value && isOwner()) {
          formData.role = roleSelect.value;
        }

        const btn = document.getElementById("createUserBtn");
        btn.classList.add("loading");
        btn.disabled = true;

        try {
          const res = await apiFetch("/api/users", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData),
          });
          const data = await res.json();
          if (data.success) {
            showToast(
              `Created account for ${escapeHtml(formData.username)}`,
              "success"
            );
            document.getElementById("newUserUsername").value = "";
            document.getElementById("newUserPassword").value = "";
            if (roleSelect) roleSelect.value = "member";
            document.getElementById("addUserForm").classList.remove("visible");
            document.getElementById("toggleAddUserBtn").textContent =
              "+ Add User";
            fetchUsers();
          } else {
            showToast(data.message || "Failed to create account", "error");
          }
        } catch (err) {
          showToast("Server connection error", "error");
        } finally {
          btn.classList.remove("loading");
          btn.disabled = false;
        }
      }

      let pendingDelete = null;

      function requestDeleteUser(id, username) {
        pendingDelete = { id, username };
        const overlay = document.getElementById("deleteConfirm");
        const name = document.getElementById("deleteConfirmName");
        if (!overlay || !name) return;
        name.textContent = username;
        overlay.classList.add("active");
        document.body.style.overflow = "hidden";
        document.getElementById("deleteConfirmYes")?.focus();
      }

      function closeDeleteConfirm(e) {
        if (e && e.target !== e.currentTarget) return;
        const overlay = document.getElementById("deleteConfirm");
        if (overlay) overlay.classList.remove("active");
        pendingDelete = null;
        if (!document.getElementById("memberModal")?.classList.contains("active")) {
          document.body.style.overflow = "";
        }
      }

      async function confirmDeleteUser() {
        if (!pendingDelete) return;
        const { id, username } = pendingDelete;
        const button = document.getElementById("deleteConfirmYes");
        if (button) {
          button.disabled = true;
          button.textContent = "Deleting...";
        }
        try {
          const res = await apiFetch(`/api/users/${encodeURIComponent(id)}`, {
            method: "DELETE",
          });
          const data = await res.json();
          if (data.success) {
            closeDeleteConfirm();
            showToast(`Deleted ${escapeHtml(username)}`, "success");
            fetchUsers();
          } else {
            showToast(data.message || "Failed to delete account", "error");
          }
        } catch (err) {
          showToast("Server connection error", "error");
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = "Yes, delete";
          }
        }
      }

