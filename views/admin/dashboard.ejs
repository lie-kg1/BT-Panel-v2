                    <code id="showTeamState">true</code>
                  </label>
                </div>
              </div>

              <div class="theme-controls">
                <div class="form-group">
                  <label class="form-label">Background Blur</label>
                  <div class="slider-control">
                    <input
                      type="range"
                      id="blurRange"
                      min="0"
                      max="100"
                      value="0"
                      oninput="updateBlur(this.value)"
                      aria-label="Background blur amount"
                    />
                    <span class="slider-value" id="blurVal">0px</span>
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Background Opacity</label>
                  <div class="slider-control">
                    <input
                      type="range"
                      id="opacityRange"
                      min="0"
                      max="100"
                      value="100"
                      oninput="updateOpacity(this.value)"
                      aria-label="Background opacity"
                    />
                    <span class="slider-value" id="opacityVal">100%</span>
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Accent Color</label>
                  <div class="color-picker-wrapper">
                    <input
