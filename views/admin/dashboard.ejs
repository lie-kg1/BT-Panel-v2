      /* ── Pterodactyl: settings ─────────────────────────────────────── */
      let pterodactylSettings = { panelUrl: "", apiKey: "", apiType: "client", allowInsecure: false };
      let pterodactylSettingsLoaded = false;
      let pterodactylConfigured = false;

      async function loadPterodactylSettings() {
        if (!currentUser) return;
        try {
          const response = await apiFetch("/api/pterodactyl/config");
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Pterodactyl settings unavailable");
          const cfg = result.pterodactyl || {};
          pterodactylConfigured = Boolean(cfg.configured);
          pterodactylSettings.panelUrl = cfg.panelUrl || "";
          pterodactylSettings.apiType = cfg.apiType || "client";
          pterodactylSettings.allowInsecure = Boolean(cfg.allowInsecure);
          pterodactylSettings.apiKey = "";
          pterodactylSettingsLoaded = true;
          syncPterodactylControls();
        } catch (error) {
          showToast(error.message || "Unable to load Pterodactyl settings", "error");
        }
      }

      function syncPterodactylControls() {
        const urlInput = document.getElementById("pterodactylPanelUrl");
        const keyInput = document.getElementById("pterodactylApiKey");
        const typeSelect = document.getElementById("pterodactylApiType");
        const insecureToggle = document.getElementById("pterodactylInsecureToggle");
        if (urlInput && document.activeElement !== urlInput) urlInput.value = pterodactylSettings.panelUrl || "";
        if (keyInput && document.activeElement !== keyInput) keyInput.value = "";
        if (typeSelect) typeSelect.value = pterodactylSettings.apiType;
        if (insecureToggle) insecureToggle.checked = pterodactylSettings.allowInsecure;
        updatePterodactylPreview();
      }

      function updatePterodactylPreview() {
        const status = document.getElementById("pterodactylStatusPreview");
        const url = document.getElementById("pterodactylUrlPreview");
        const hasKey = pterodactylSettings.apiKey.trim() !== "" || pterodactylConfigured;
        const configured = Boolean(pterodactylSettings.panelUrl && hasKey);
        if (status) status.textContent = configured ? "Configured" : "Not configured";
        if (url) url.textContent = pterodactylSettings.panelUrl || "—";
      }

      function updatePterodactylSetting(key, value) {
        if (key === "allowInsecure") pterodactylSettings.allowInsecure = Boolean(value);
        else if (key === "apiType") pterodactylSettings.apiType = value === "application" ? "application" : "client";
        else if (key === "panelUrl") pterodactylSettings.panelUrl = String(value || "").trim();
        else if (key === "apiKey") pterodactylSettings.apiKey = String(value || "");
        updatePterodactylPreview();
      }

      async function savePterodactylSettings() {
        const button = document.getElementById("savePterodactylBtn");
        if (button) button.disabled = true;
        try {
          const response = await apiFetch("/api/pterodactyl/config", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(pterodactylSettings),
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to save Pterodactyl settings");
          pterodactylConfigured = Boolean(result.pterodactyl && result.pterodactyl.configured);
          pterodactylSettings.panelUrl = (result.pterodactyl && result.pterodactyl.panelUrl) || pterodactylSettings.panelUrl;
          pterodactylSettings.apiType = (result.pterodactyl && result.pterodactyl.apiType) || pterodactylSettings.apiType;
          pterodactylSettings.allowInsecure = Boolean(result.pterodactyl && result.pterodactyl.allowInsecure);
          pterodactylSettings.apiKey = "";
          syncPterodactylControls();
          showToast("Pterodactyl settings saved.", "success");
        } catch (error) {
          showToast(error.message || "Unable to save Pterodactyl settings", "error");
        } finally {
          if (button) button.disabled = false;
        }
      }

