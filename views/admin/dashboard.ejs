                    <input
                      type="color"
                      id="glassTintPicker"
                      value="#000000"
                      onchange="updateGlassTint(this.value)"
                      class="color-picker"
                      aria-label="Glass tint color picker"
                    />
                  </div>
                  <div class="form-hint">
                    Base color for glassmorphism panels
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Glass Opacity</label>
                  <div class="slider-control">
                    <input
                      type="range"
                      id="glassOpacityRange"
                      min="0"
                      max="100"
                      value="22"
                      oninput="updateGlassOpacity(this.value)"
                      aria-label="Glass opacity amount"
                    />
                    <span class="slider-value" id="glassOpacityVal">22%</span>
                  </div>
                  <div class="form-hint">
                    0% = fully transparent, 100% = full tint
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">Nav Text</label>
                  <div class="color-picker-wrapper">
                    <input
                      type="color"
                      id="navTextPicker"
