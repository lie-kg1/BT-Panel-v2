      function filterWallpaperLibrary() {
        const search = (document.getElementById("wallpaperSearch")?.value || "").trim().toLowerCase();
        document.querySelectorAll(".wallpaper-card").forEach((card) => {
          card.hidden = Boolean(search) && !String(card.dataset.title || "").includes(search);
        });
      }

      function renderWallpaperCategories(categories) {
        const container = document.getElementById("wallpaperCategories");
        if (!container || !Array.isArray(categories)) return;
        container.innerHTML = "";
        categories.forEach((category) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `settings-tab${category.id === wallpaperCategory ? " active" : ""}`;
          button.textContent = category.name;
          button.setAttribute("aria-selected", String(category.id === wallpaperCategory));
          button.addEventListener("click", () => {
            wallpaperCategory = category.id;
            loadWallpaperPage(1, wallpaperCategory);
          });
          container.appendChild(button);
        });
      }

      function renderWallpaperCards(wallpapers) {
        const grid = document.getElementById("wallpaperGrid");
        if (!grid) return;
        grid.innerHTML = "";
        (Array.isArray(wallpapers) ? wallpapers : []).forEach((wallpaper) => {
          const imageUrl = wallpaper.thumb || wallpaper.preview || wallpaper.full;
          const applyUrl = wallpaper.full || wallpaper.preview || wallpaper.thumb;
          if (!imageUrl || !applyUrl) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "wallpaper-card";
          button.dataset.title = `${wallpaper.title || "Wallpaper"} ${(wallpaper.tags || []).join(" ")}`.toLowerCase();
          button.addEventListener("click", () => selectWallpaperFromLibrary(applyUrl, wallpaper.title || "Wallpaper", button));
          const image = document.createElement("img");
          image.src = imageUrl;
          image.alt = wallpaper.title || "4K wallpaper";
          image.loading = "lazy";
          const caption = document.createElement("span");
          caption.className = "wallpaper-card-caption";
          const title = document.createElement("span");
          title.textContent = wallpaper.title || "Wallpaper";
          const tags = document.createElement("span");
          tags.textContent = (wallpaper.tags || ["4K"]).slice(0, 2).join(" · ");
          caption.append(title, tags);
          button.append(image, caption);
          grid.appendChild(button);
        });
        grid.dataset.serviceLoaded = "true";
      }

      async function loadWallpaperPage(page = 1, category = wallpaperCategory) {
        const grid = document.getElementById("wallpaperGrid");
        if (!grid) return;
        const requestedPage = Math.max(1, Number(page) || 1);
        wallpaperCategory = category || "all";
        const query = (document.getElementById("wallpaperSearch")?.value || "").trim();
        const params = new URLSearchParams({ category: wallpaperCategory, page: String(requestedPage), query });
        try {
          const response = await apiFetch(`/api/wallpapers?${params.toString()}`);
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.message || "Wallpaper service unavailable");
          wallpaperPage = result.page || requestedPage;
          renderWallpaperCategories(result.categories);
          renderWallpaperCards(result.wallpapers);
          document.getElementById("wallpaperPageLabel").textContent = `Page ${wallpaperPage}`;
          document.getElementById("wallpaperPrev").disabled = !result.hasPrev;
          document.getElementById("wallpaperNext").disabled = !result.hasNext;
        } catch (error) {
          grid.dataset.serviceLoaded = "false";
          filterWallpaperLibrary();
        }
      }

      function selectWallpaperFromLibrary(url, label, button) {
        selectedWallpaperUrl = url;
        themeSettings = { ...themeSettings, wallpaperUrl: url };
        const urlInput = document.getElementById("externalBackgroundUrl");
        if (urlInput) urlInput.value = url;
        document.querySelectorAll(".wallpaper-card").forEach((card) => card.classList.remove("selected"));
        button?.classList.add("selected");
        applyThemeToPage({ ...themeSettings, wallpaperUrl: url });
        showToast(`${label} selected. Click Save Theme to persist.`, "success");
      }

