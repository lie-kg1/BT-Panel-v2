          <div class="modal-stat">
            <div class="modal-stat-value" id="modalJoined">—</div>
            <div class="modal-stat-label">Joined</div>
          </div>
        </div>
        <div class="modal-bio" id="modalBio">No bio yet.</div>
      </div>
    </div>

    <!-- Delete Confirmation -->
    <div
      class="confirm-overlay"
      id="deleteConfirm"
      onclick="closeDeleteConfirm(event)"
      role="dialog"
      aria-modal="true"
      aria-labelledby="deleteConfirmTitle"
    >
      <div class="confirm-card" onclick="event.stopPropagation()">
        <div class="confirm-icon" aria-hidden="true">!</div>
        <div class="confirm-title" id="deleteConfirmTitle">Confirm action</div>
        <p class="confirm-message">
          Delete account <strong id="deleteConfirmName"></strong>? This cannot be undone.
        </p>
        <div class="confirm-actions">
          <button class="btn btn-ghost" type="button" onclick="closeDeleteConfirm()">No</button>
          <button class="btn btn-danger" id="deleteConfirmYes" type="button" onclick="confirmDeleteUser()">Yes, delete</button>
        </div>
      </div>
    </div>
  </body>
</html>
