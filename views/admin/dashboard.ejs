    <script>
      /* ═══════════════════════════════════════════════════════════════
       STATE
       ═══════════════════════════════════════════════════════════════ */
      let currentUser = null;
      let teamUsers = [];
      let teamFilter = "all";
      let userUsers = [];
      let userFilter = "all";
      let selectedWallpaperUrl = "";
      const CONFIG = {
        backgroundBasePath: "/media/",
        profileBasePath: "/profile/",
      };
      let themeSettings = {};
      let isSavingTheme = false;

      /* ═══════════════════════════════════════════════════════════════
       ROLE HELPERS
       ═══════════════════════════════════════════════════════════════ */
      function isOwner() {
        return currentUser?.role === "owner";
      }
      function isAdmin() {
        return currentUser?.role === "admin" || isOwner();
      }
      function canManageUsers() {
        return isAdmin();
      }
      function canDeleteUser(targetUser) {
        if (!targetUser || !currentUser) return false;
        if (isOwner()) return targetUser.id !== currentUser.id;
        if (currentUser.role === "admin") return targetUser.role === "member";
        return false;
      }

      function applyNavigationVisibility() {
        const showTeam = themeSettings.showTeam !== false;
        const teamNav = document.getElementById("nav-team");
        const settingsNav = document.getElementById("nav-settings");
        if (teamNav) teamNav.style.display = showTeam ? "" : "none";
        if (settingsNav) settingsNav.style.display = isAdmin() ? "" : "none";
        const musicNav = document.getElementById("nav-music");
        if (musicNav) musicNav.style.display = currentUser ? "" : "none";

        const activeView = document.querySelector(".view.active")?.id;
        if (activeView === "view-team" && !showTeam) switchView("home");
        if (activeView === "view-settings" && !isAdmin()) switchView("music");
      }

      function updateNavigationSetting(setting, value) {
        if (setting !== "showTeam") return;
        themeSettings.showTeam = Boolean(value);
        const teamState = document.getElementById("showTeamState");
        if (teamState) teamState.textContent = themeSettings.showTeam ? "true" : "false";
        applyNavigationVisibility();
        showToast(`Team ${value ? "shown" : "hidden"}. Click Save Theme to persist.`, "success");
      }

      function syncNavigationControls() {
        const teamToggle = document.getElementById("showTeamToggle");
        if (teamToggle) teamToggle.checked = themeSettings.showTeam !== false;
        const teamState = document.getElementById("showTeamState");
        if (teamState) teamState.textContent = themeSettings.showTeam !== false ? "true" : "false";
      }
      function displayRole(role) {
        const r = (role || "member").toLowerCase();
        return r === "member" ? "MEMBER" : "";
      }

      function roleBadge(role) {
        const r = (role || "member").toLowerCase();
        const isAdminRole = r === "owner" || r === "admin";
        const cls = isAdminRole ? "badge-admin" : "badge-member";
        const label = r === "member" ? "MEMBER" : isAdminRole ? "ADMIN" : r.toUpperCase();
        return `<span class="badge ${cls}">${label}</span>`;
      }
      function presenceBadge(online) {
        return `<span class="badge ${online ? "badge-online" : "badge-offline"}">${online ? "ONLINE" : "OFFLINE"}</span>`;
      }
      function formatDate(ts) {
        if (!ts) return "—";
        const d = new Date(ts);
        return (
          d.toLocaleDateString(undefined, {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          }) +
          " " +
          d.toLocaleTimeString(undefined, {
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          })
        );
      }
      function formatDateOnly(ts) {
        if (!ts) return "—";
        const d = new Date(ts);
        return d.toLocaleDateString(undefined, {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        });
      }
      function defaultAvatarHtml() {
        return `<svg class="default-avatar-image default-avatar-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" role="img" aria-label="Default avatar"><rect width="128" height="128" rx="32" fill="#4F46E5"></rect><circle cx="64" cy="48" r="20" fill="#FFFFFF"></circle><path d="M32 104C32 80 44 76 64 76s32 4 32 28Z" fill="#FFFFFF"></path></svg>`;
      }

      function renderAvatar(img, fallback, profilePic) {
        if (!img || !fallback) return;
        const container = img.parentElement;
        const showDefault = () => {
          img.onerror = null;
          img.removeAttribute("src");
          img.classList.remove("visible");
          container?.classList.add("has-default-avatar");
          fallback.innerHTML = defaultAvatarHtml();
        };
        img.onerror = showDefault;
        if (profilePic) {
          fallback.textContent = "";
          container?.classList.remove("has-default-avatar");
          img.src = CONFIG.profileBasePath + encodeURIComponent(profilePic);
          img.classList.add("visible");
        } else {
          showDefault();
        }
      }

      function viewIconSvg() {
        return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
      }

      function userAvatarHtml(user, showPresence = false) {
        const hasProfilePic = Boolean(user.profilePic);
        const avatar = hasProfilePic
          ? `<img src="${CONFIG.profileBasePath + encodeURIComponent(user.profilePic)}" alt="" onerror="this.onerror=null;var p=this.parentElement;p.classList.add('has-default-avatar');this.outerHTML=defaultAvatarHtml()">`
          : defaultAvatarHtml();
        const presence = showPresence
          ? `<span class="avatar-presence-dot ${user.online ? "online" : "offline"}" title="${user.online ? "Online" : "Offline"}" aria-label="${user.online ? "Online" : "Offline"}"></span>`
          : "";
        const stateClass = hasProfilePic ? "" : " has-default-avatar";
        return `<div class="user-cell-avatar avatar-with-presence${stateClass}">${avatar}${presence}</div>`;
      }

      /* ═══════════════════════════════════════════════════════════════
       NAVIGATION
       ═══════════════════════════════════════════════════════════════ */
      const VIEW_TITLES = {
        home: "Home",
        team: "Team Members",
        settings: "Admin Settings",
        music: "Music",
        users: "User Accounts",
        account: "My Profile",
        servers: "Game Servers",
      };
      const VIEW_PATHS = {
        home: "/",
        team: "/team",
        settings: "/settings",
        music: "/music",
        users: "/users",
        account: "/account",
        servers: "/servers",
      };

      function viewFromPathname() {
        const pathname = window.location.pathname.replace(/\/+$/, "") || "/";
        return Object.keys(VIEW_PATHS).find((name) => VIEW_PATHS[name] === pathname) || "home";
      }

      function switchView(viewName, updateUrl = true) {
        // Guard restricted views
        if (viewName === "settings" && !isAdmin()) {
          switchView("music");
          return;
        }
        if (viewName === "team" && themeSettings.showTeam === false) {
          switchView("home");
          return;
        }
        if (viewName === "users" && !canManageUsers()) {
          switchView("home");
          return;
        }

        if (updateUrl && VIEW_PATHS[viewName] && window.location.pathname !== VIEW_PATHS[viewName]) {
          window.history.pushState({ viewName }, "", VIEW_PATHS[viewName]);
        }

        // Update header title
        const titleEl = document.getElementById("headerTitle");
        if (titleEl) titleEl.textContent = VIEW_TITLES[viewName] || "BT PANEL";

        // Hide all views
        document
          .querySelectorAll(".view")
          .forEach((v) => v.classList.remove("active"));
        document.querySelectorAll(".nav-item").forEach((n) => {
          n.classList.remove("active");
          n.setAttribute("aria-selected", "false");
        });

        // Show target view
        const targetViewName = viewName === "music" ? "settings" : viewName;
        const viewEl = document.getElementById(`view-${targetViewName}`);
        if (viewEl) viewEl.classList.add("active");
        // Reapply the in-memory theme when navigating between dashboard views.
        // This prevents the saved wallpaper from disappearing while Admin Settings opens.
        if (Object.keys(themeSettings).length > 0) applyThemeToPage(themeSettings);

        const navEl = document.getElementById(`nav-${viewName}`);
        if (navEl && navEl.style.display !== "none") {
          navEl.classList.add("active");
          navEl.setAttribute("aria-selected", "true");
        }

        // Close mobile sidebar if open
        const sidebar = document.querySelector(".sidebar");
        if (sidebar && sidebar.classList.contains("mobile-open")) {
          setMobileSidebarOpen(false);
        }

        // Load view-specific data
        if (viewName === "home") renderHome();
        if (viewName === "account") renderAccountInfo();
        if (viewName === "users") fetchUsers();
        if (viewName === "team") fetchTeam();
        if (viewName === "settings") {
          const requestedTab = new URLSearchParams(window.location.search).get("tab");
          switchSettingsTab(SETTINGS_TABS.includes(requestedTab) ? requestedTab : "appearance");
        }
        if (viewName === "music") switchSettingsTab("music");
        if (viewName === "servers") initServersView();
        if (viewName !== "servers" && serversViewActive) teardownServersView();
      }

      const SETTINGS_TABS = ["appearance", "wallpapers", "general", "music", "bars", "pterodactyl"];
      let wallpaperPage = 1;
      let wallpaperCategory = "all";
      let musicSettingsLoaded = false;
      let musicSettings = { enabled: false, autoplay: false, loop: true, volume: 0.35, selectedTrackId: "", tracks: [] };
      let musicVolumeBeforeMute = null;
      let generalSettingsLoaded = false;
      let generalSettings = { panelName: "BT PANEL", panelSubtitle: "", welcomeTitle: "Welcome", welcomeMessage: "Manage your panel from one place." };
      let barsSettingsLoaded = false;
      let barsSettings = { showAdminStats: true, showVersion: true, showRole: true, showHeaderUser: true };

      function applySettingsRoleVisibility() {
        const memberMode = Boolean(currentUser) && !isAdmin();
        document.querySelectorAll(".settings-tab").forEach((tab) => {
          const tabName = tab.id.replace("settings-tab-", "");
          const allowed = !memberMode || tabName === "music";
          tab.style.display = allowed ? "" : "none";
          tab.setAttribute("aria-hidden", String(!allowed));
        });
        document.querySelectorAll("[data-admin-only-music]").forEach((element) => {
          element.style.display = memberMode ? "none" : "";
        });
        const note = document.getElementById("musicRoleNote");
        if (note) note.style.display = memberMode ? "" : "none";
      }

      function switchSettingsTab(tabName) {
        const requestedTab = SETTINGS_TABS.includes(tabName) ? tabName : "appearance";
        const activeTab = !isAdmin() && requestedTab !== "music" ? "music" : requestedTab;
        applySettingsRoleVisibility();
        document.querySelectorAll(".settings-tab").forEach((tab) => {
          const selected = tab.id === `settings-tab-${activeTab}`;
          tab.classList.toggle("active", selected);
          tab.setAttribute("aria-selected", String(selected));
        });
        document.querySelectorAll(".settings-tab-panel").forEach((panel) => {
          panel.classList.toggle("active", panel.id === `settings-panel-${activeTab}`);
        });
        if (activeTab === "appearance") {
          if (Object.keys(themeSettings).length === 0) loadSettings();
          else applyThemeToPage(themeSettings);
        }
        if (activeTab === "wallpapers") loadWallpaperPage(1, wallpaperCategory);
        if (activeTab === "music" && !musicSettingsLoaded) loadMusicSettings();
        if (activeTab === "general" && !generalSettingsLoaded) loadGeneralSettings();
        if (activeTab === "bars" && !barsSettingsLoaded) loadBarsSettings();
        if (activeTab === "pterodactyl" && !pterodactylSettingsLoaded) loadPterodactylSettings();
      }

      async function loadGeneralSettings() {
        if (!currentUser) return;
        try {
          const response = await apiFetch("/api/general");
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "General settings unavailable");
          generalSettings = result.general || generalSettings;
          generalSettingsLoaded = true;
          applyGeneralSettings();
        } catch (error) {
          showToast(error.message || "Unable to load General settings", "error");
        }
      }

      function syncGeneralControls() {
        const fields = {
          generalPanelName: generalSettings.panelName,
          generalPanelSubtitle: generalSettings.panelSubtitle,
          generalWelcomeTitle: generalSettings.welcomeTitle,
          generalWelcomeMessage: generalSettings.welcomeMessage,
        };
        Object.entries(fields).forEach(([id, value]) => {
          const element = document.getElementById(id);
          if (element && document.activeElement !== element) element.value = value || "";
        });
        const previewTitle = document.getElementById("generalPreviewTitle");
        const previewCopy = document.getElementById("generalPreviewCopy");
        if (previewTitle) previewTitle.textContent = generalSettings.welcomeTitle;
        if (previewCopy) previewCopy.textContent = generalSettings.welcomeMessage;
      }

      function applyGeneralSettings() {
        const name = generalSettings.panelName || "BT PANEL";
        const subtitle = generalSettings.panelSubtitle || "";
        const title = generalSettings.welcomeTitle || "Welcome";
        const message = generalSettings.welcomeMessage || "Manage your panel from one place.";
        const brand = document.getElementById("panelBrandName");
        const brandContainer = document.querySelector(".sidebar-brand");
        const subtitleEl = document.getElementById("homePanelSubtitle");
        const welcomeTitle = document.getElementById("homeWelcomeTitle");
        const welcomeMessage = document.getElementById("homeWelcomeMessage");
        if (brand) brand.textContent = name;
        if (brandContainer) brandContainer.setAttribute("aria-label", name);
        if (subtitleEl) subtitleEl.textContent = subtitle;
        if (welcomeTitle) welcomeTitle.textContent = title;
        if (welcomeMessage) welcomeMessage.textContent = message;
        document.title = name;
        syncGeneralControls();
      }

      function updateGeneralText(key, value) {
        if (!Object.prototype.hasOwnProperty.call(generalSettings, key)) return;
        const maxLength = key === "welcomeMessage" ? 240 : key === "panelSubtitle" ? 120 : key === "panelName" ? 48 : 80;
        generalSettings[key] = String(value || "").slice(0, maxLength);
        applyGeneralSettings();
      }

      async function saveGeneralSettings() {
        const button = document.getElementById("saveGeneralBtn");
        if (button) button.disabled = true;
        try {
          const response = await apiFetch("/api/general", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(generalSettings) });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to save General settings");
          generalSettings = result.general || generalSettings;
          generalSettingsLoaded = true;
          applyGeneralSettings();
          showToast("General settings saved.", "success");
        } catch (error) {
          showToast(error.message || "Unable to save General settings", "error");
        } finally {
          if (button) button.disabled = false;
        }
      }

      function resetGeneralSettings() {
        generalSettings = { panelName: "BT PANEL", panelSubtitle: "", welcomeTitle: "Welcome", welcomeMessage: "Manage your panel from one place." };
        applyGeneralSettings();
        showToast("General settings reset. Click Save General to persist.", "success");
      }

      async function loadBarsSettings() {
        if (!currentUser) return;
        try {
          const response = await apiFetch("/api/bars");
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Bars settings unavailable");
          barsSettings = result.bars || barsSettings;
          barsSettingsLoaded = true;
          applyBarsSettings();
        } catch (error) {
          showToast(error.message || "Unable to load Bars settings", "error");
        }
      }

      function syncBarsControls() {
        const controls = {
          barsAdminStatsToggle: barsSettings.showAdminStats !== false,
          barsVersionToggle: barsSettings.showVersion !== false,
          barsRoleToggle: barsSettings.showRole !== false,
          barsHeaderUserToggle: barsSettings.showHeaderUser !== false,
        };
        Object.entries(controls).forEach(([id, checked]) => {
          const element = document.getElementById(id);
          if (element) element.checked = checked;
        });
        const admin = document.getElementById("barsPreviewAdminStats");
        const version = document.getElementById("barsPreviewVersion");
        const account = document.getElementById("barsPreviewAccount");
        if (admin) admin.textContent = barsSettings.showAdminStats !== false ? "ON" : "OFF";
        if (version) version.textContent = barsSettings.showVersion !== false ? "ON" : "OFF";
        if (account) account.textContent = `${barsSettings.showRole !== false ? "ON" : "OFF"} / ${barsSettings.showHeaderUser !== false ? "ON" : "OFF"}`;
      }

      function applyBarsSettings() {
        const adminStats = document.getElementById("home-admin-stats");
        const version = document.getElementById("home-version-stat");
        const role = document.getElementById("homeRolePhrase");
        const headerUser = document.getElementById("headerUser");
        if (adminStats) adminStats.style.display = isAdmin() && barsSettings.showAdminStats !== false ? "" : "none";
        if (version) version.style.display = barsSettings.showVersion !== false ? "" : "none";
        if (role) role.style.display = barsSettings.showRole !== false ? "" : "none";
        if (headerUser) headerUser.style.display = barsSettings.showHeaderUser !== false ? "" : "none";
        syncBarsControls();
      }

      function updateBarsSetting(key, value) {
        if (!Object.prototype.hasOwnProperty.call(barsSettings, key)) return;
        barsSettings[key] = Boolean(value);
        applyBarsSettings();
      }

      async function saveBarsSettings() {
        const button = document.getElementById("saveBarsBtn");
        if (button) button.disabled = true;
        try {
          const response = await apiFetch("/api/bars", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(barsSettings) });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to save Bars settings");
          barsSettings = result.bars || barsSettings;
          barsSettingsLoaded = true;
          applyBarsSettings();
          showToast("Bars settings saved.", "success");
        } catch (error) {
          showToast(error.message || "Unable to save Bars settings", "error");
        } finally {
          if (button) button.disabled = false;
        }
      }

      function resetBarsSettings() {
        barsSettings = { showAdminStats: true, showVersion: true, showRole: true, showHeaderUser: true };
        applyBarsSettings();
        showToast("Bars settings reset. Click Save Bars to persist.", "success");
      }

      async function loadMusicSettings() {
        if (!currentUser) return;
        try {
          const response = await apiFetch("/api/music");
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Music service unavailable");
          musicSettings = result.music || musicSettings;
          musicSettingsLoaded = true;
          renderMusicTracks();
          syncMusicControls();
          applyMusicSettings(false);
        } catch (error) {
          showToast(error.message || "Unable to load music settings", "error");
        }
      }

      function renderMusicTracks() {
        const list = document.getElementById("musicTrackList");
        if (!list) return;
        list.innerHTML = "";
        const tracks = Array.isArray(musicSettings.tracks) ? musicSettings.tracks : [];
        if (!tracks.length) {
          list.innerHTML = '<div class="music-empty">No music tracks yet. Add a URL or upload an audio file.</div>';
          updateMusicNowPlaying();
          return;
        }
        tracks.forEach((track) => {
          const row = document.createElement("div");
          row.className = `music-track-row${track.id === musicSettings.selectedTrackId ? " selected" : ""}`;
          const art = document.createElement("span");
          art.className = "music-track-art";
          art.setAttribute("aria-hidden", "true");
          art.innerHTML = '<svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l10-2v13" fill="none"></path><circle cx="6" cy="18" r="3"></circle><circle cx="16" cy="16" r="3"></circle></svg>';
          const select = document.createElement("button");
          select.type = "button";
          select.className = "music-track-select";
          select.addEventListener("click", () => selectMusicTrack(track.id, true));
          const name = document.createElement("span");
          name.className = "music-track-name";
          name.textContent = track.name || "Untitled track";
          const source = document.createElement("span");
          source.className = "music-track-source";
          source.textContent = track.source === "upload" ? "Uploaded audio" : "External URL";
          select.append(name, source);
          const play = document.createElement("button");
          play.type = "button";
          play.className = "music-icon-btn";
          play.title = "Play track";
          play.setAttribute("aria-label", `Play ${track.name || "track"}`);
          play.innerHTML = MUSIC_ICON_PLAY;
          play.addEventListener("click", () => selectMusicTrack(track.id, true));
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "music-icon-btn danger";
          remove.title = "Delete track";
          remove.setAttribute("aria-label", `Delete ${track.name || "track"}`);
          remove.textContent = "×";
          remove.addEventListener("click", () => deleteMusicTrack(track.id));
          remove.style.display = isAdmin() ? "" : "none";
          row.append(art, select, play, remove);
          list.appendChild(row);
        });
        updateMusicNowPlaying();
      }

      const MUSIC_ICON_PLAY = '<svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"></path></svg>';
      const MUSIC_ICON_PAUSE = '<svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"></path></svg>';
      const MUSIC_ICON_VOLUME = '<svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4z"></path><path d="M17 9a5 5 0 0 1 0 6M19 6a9 9 0 0 1 0 12" fill="none"></path></svg>';
      const MUSIC_ICON_MUTED = '<svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4z"></path><path d="m17 9 4 6m0-6-4 6" fill="none"></path></svg>';

      function formatMusicTime(seconds) {
        const total = Number.isFinite(Number(seconds)) && Number(seconds) > 0 ? Math.floor(Number(seconds)) : 0;
        return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
      }

      function seekMusicTrack(value) {
        const audio = document.getElementById("musicAudio");
        const nextTime = Number(value);
        if (!audio || !Number.isFinite(nextTime) || !Number.isFinite(audio.duration)) return;
        audio.currentTime = Math.min(Math.max(nextTime, 0), audio.duration);
        syncMusicControls();
      }

      function syncMusicControls() {
        const enabled = document.getElementById("musicEnabledToggle");
        const autoplay = document.getElementById("musicAutoplayToggle");
        const loop = document.getElementById("musicLoopToggle");
        const volume = document.getElementById("musicVolumeRange");
        const value = Math.round((Number(musicSettings.volume) || 0) * 100);
        if (enabled) enabled.checked = musicSettings.enabled === true;
        if (autoplay) autoplay.checked = musicSettings.autoplay === true;
        if (loop) loop.checked = musicSettings.loop !== false;
        if (volume) volume.value = String(value);
        const volumeLabel = document.getElementById("musicVolumeValue");
        if (volumeLabel) volumeLabel.textContent = `${value}%`;
        const audio = document.getElementById("musicAudio");
        const currentTime = Number.isFinite(audio?.currentTime) ? audio.currentTime : 0;
        const duration = Number.isFinite(audio?.duration) ? audio.duration : 0;
        const seekRange = document.getElementById("musicSeekRange");
        const currentTimeLabel = document.getElementById("musicCurrentTime");
        const durationLabel = document.getElementById("musicDuration");
        if (seekRange) {
          seekRange.max = String(duration);
          seekRange.value = String(Math.min(currentTime, duration || 0));
          seekRange.disabled = duration <= 0;
        }
        if (currentTimeLabel) currentTimeLabel.textContent = formatMusicTime(currentTime);
        if (durationLabel) durationLabel.textContent = formatMusicTime(duration);
        const hasTrack = Boolean(selectedMusicTrack());
        document.querySelectorAll("[data-music-requires-track]").forEach((control) => {
          control.disabled = !hasTrack;
        });
        const playing = audio && !audio.paused && !audio.ended;
        const playButton = document.getElementById("musicPlayBtn");
        const transportPlayButton = document.getElementById("musicTransportPlayBtn");
        if (playButton) playButton.textContent = playing ? "Pause selected" : "Play selected";
        if (transportPlayButton) {
          transportPlayButton.innerHTML = playing ? MUSIC_ICON_PAUSE : MUSIC_ICON_PLAY;
          transportPlayButton.setAttribute("aria-label", playing ? "Pause selected track" : "Play selected track");
          transportPlayButton.title = playing ? "Pause selected track" : "Play selected track";
          transportPlayButton.setAttribute("aria-pressed", String(Boolean(playing)));
        }
        const muteButton = document.getElementById("musicMuteBtn");
        if (muteButton) {
          const muted = Boolean(audio?.muted || Number(musicSettings.volume) <= 0);
          muteButton.innerHTML = muted ? MUSIC_ICON_MUTED : MUSIC_ICON_VOLUME;
          muteButton.setAttribute("aria-label", muted ? "Unmute music" : "Mute music");
          muteButton.title = muted ? "Unmute music" : "Mute music";
          muteButton.setAttribute("aria-pressed", String(muted));
        }
        updateMusicStatus();
      }

      function selectedMusicTrack() {
        return (musicSettings.tracks || []).find((track) => track.id === musicSettings.selectedTrackId) || null;
      }

      function updateMusicNowPlaying() {
        const track = selectedMusicTrack();
        const title = document.getElementById("musicNowPlaying");
        const meta = document.getElementById("musicNowMeta");
        const trackTitle = track ? track.name : "No track selected";
        const trackMeta = track ? `${track.artist || (track.source === "upload" ? "Uploaded audio" : "External URL")} · ${Math.round((Number(musicSettings.volume) || 0) * 100)}% volume` : "Add a track in Music settings";
        if (title) title.textContent = trackTitle;
        if (meta) meta.textContent = trackMeta;
      }

      function updateMusicStatus() {
        const status = document.getElementById("musicStatus");
        if (!status) return;
        const audio = document.getElementById("musicAudio");
        const playing = audio && !audio.paused && !audio.ended;
        status.textContent = playing ? "Playing" : musicSettings.enabled ? "Enabled" : "Disabled";
        status.classList.toggle("active", Boolean(playing || musicSettings.enabled));
      }

      function startMusicPlayback() {
        const audio = document.getElementById("musicAudio");
        if (!audio) return;
        const playback = audio.play();
        if (!playback || typeof playback.then !== "function") {
          syncMusicControls();
          return;
        }
        playback.then(() => {
          syncMusicControls();
        }).catch((error) => {
          syncMusicControls();
          if (error?.name === "NotAllowedError") {
            showToast("Click Play selected to start audio in this browser.", "error");
          } else {
            showToast("Unable to start this audio track.", "error");
          }
        });
      }

      function applyMusicSettings(shouldPlay = false) {
        const audio = document.getElementById("musicAudio");
        if (!audio) return;
        const track = selectedMusicTrack();
        audio.loop = musicSettings.loop !== false;
        audio.volume = Math.min(1, Math.max(0, Number(musicSettings.volume) || 0));
        if (track && audio.dataset.trackId !== track.id) {
          audio.src = track.url;
          audio.dataset.trackId = track.id;
          audio.load();
        }
        updateMusicNowPlaying();
        if (track && musicSettings.enabled && shouldPlay) {
          startMusicPlayback();
        } else if (!musicSettings.enabled) {
          audio.pause();
        }
        syncMusicControls();
      }

      function selectMusicTrack(trackId, shouldPlay = false) {
        musicSettings.selectedTrackId = trackId;
        musicSettings.enabled = shouldPlay ? true : musicSettings.enabled;
        renderMusicTracks();
        applyMusicSettings(shouldPlay);
      }

      function updateMusicEnabled(value) {
        musicSettings.enabled = Boolean(value);
        applyMusicSettings(musicSettings.enabled);
      }

      function updateMusicAutoplay(value) {
        musicSettings.autoplay = Boolean(value);
        syncMusicControls();
      }

      function updateMusicLoop(value) {
        musicSettings.loop = Boolean(value);
        const audio = document.getElementById("musicAudio");
        if (audio) audio.loop = musicSettings.loop;
        syncMusicControls();
      }

      function updateMusicVolume(value) {
        musicSettings.volume = Math.min(1, Math.max(0, Number(value) / 100));
        const audio = document.getElementById("musicAudio");
        if (audio) {
          audio.volume = musicSettings.volume;
          if (musicSettings.volume > 0) audio.muted = false;
        }
        if (musicSettings.volume > 0) musicVolumeBeforeMute = musicSettings.volume;
        syncMusicControls();
        updateMusicNowPlaying();
      }

      function toggleMusicMute() {
        const audio = document.getElementById("musicAudio");
        if (!audio) return;
        if (audio.muted || Number(musicSettings.volume) <= 0) {
          const restoredVolume = musicVolumeBeforeMute || 0.35;
          musicSettings.volume = Math.min(1, Math.max(0.05, restoredVolume));
          audio.volume = musicSettings.volume;
          audio.muted = false;
        } else {
          musicVolumeBeforeMute = musicSettings.volume || audio.volume || 0.35;
          audio.muted = true;
        }
        syncMusicControls();
        updateMusicNowPlaying();
      }

      function skipMusicTrack(direction) {
        const tracks = Array.isArray(musicSettings.tracks) ? musicSettings.tracks : [];
        if (!tracks.length) {
          showToast("Add a music track first.", "error");
          return;
        }
        const currentIndex = Math.max(0, tracks.findIndex((track) => track.id === musicSettings.selectedTrackId));
        const nextIndex = (currentIndex + Number(direction || 0) + tracks.length) % tracks.length;
        selectMusicTrack(tracks[nextIndex].id, true);
      }

      function toggleMusicPlayback() {
        const audio = document.getElementById("musicAudio");
        const track = selectedMusicTrack();
        if (!audio || !track) {
          showToast("Add or select a music track first.", "error");
          return;
        }
        if (audio.paused || audio.ended) {
          musicSettings.enabled = true;
          applyMusicSettings(true);
        } else {
          audio.pause();
          musicSettings.enabled = false;
          syncMusicControls();
        }
      }

      async function addExternalMusicTrack() {
        if (!isAdmin()) {
          showToast("Only administrators can add music tracks.", "error");
          return;
        }
        const urlInput = document.getElementById("musicTrackUrl");
        const nameInput = document.getElementById("musicTrackName");
        const url = (urlInput?.value || "").trim();
        const name = (nameInput?.value || "").trim();
        if (!url) {
          showToast("Enter a direct audio URL first.", "error");
          return;
        }
        try {
          const response = await apiFetch("/api/music/track", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name, url }) });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to add track");
          musicSettings = result.music;
          urlInput.value = "";
          nameInput.value = "";
          musicSettingsLoaded = true;
          renderMusicTracks();
          syncMusicControls();
          showToast("Music track added.", "success");
        } catch (error) {
          showToast(error.message || "Unable to add track", "error");
        }
      }

      async function uploadMusicTrack(file) {
        if (!isAdmin()) {
          showToast("Only administrators can upload music.", "error");
          return;
        }
        if (!file) return;
        const form = new FormData();
        form.append("file", file);
        try {
          const response = await apiFetch("/api/music/upload", { method: "POST", body: form });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to upload audio");
          musicSettings = result.music;
          musicSettingsLoaded = true;
          renderMusicTracks();
          syncMusicControls();
          showToast("Audio uploaded.", "success");
        } catch (error) {
          showToast(error.message || "Unable to upload audio", "error");
        } finally {
          const input = document.getElementById("musicFileInput");
          if (input) input.value = "";
        }
      }

      async function deleteMusicTrack(trackId) {
        if (!isAdmin()) {
          showToast("Only administrators can delete music tracks.", "error");
          return;
        }
        if (!window.confirm("Delete this music track?")) return;
        try {
          const response = await apiFetch(`/api/music/${encodeURIComponent(trackId)}`, { method: "DELETE" });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to delete track");
          const audio = document.getElementById("musicAudio");
          if (audio?.dataset.trackId === trackId) {
            audio.pause();
            audio.removeAttribute("src");
            delete audio.dataset.trackId;
          }
          musicSettings = result.music;
          renderMusicTracks();
          syncMusicControls();
          applyMusicSettings(false);
          showToast("Music track deleted.", "success");
        } catch (error) {
          showToast(error.message || "Unable to delete track", "error");
        }
      }

      async function saveMusicSettings() {
        if (!isAdmin()) {
          showToast("Only administrators can save music settings.", "error");
          return;
        }
        const button = document.getElementById("saveMusicBtn");
        if (button) button.disabled = true;
        try {
          const response = await apiFetch("/api/music", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ enabled: musicSettings.enabled, autoplay: musicSettings.autoplay, loop: musicSettings.loop, volume: musicSettings.volume, selectedTrackId: musicSettings.selectedTrackId }) });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to save music settings");
          musicSettings = result.music;
          musicSettingsLoaded = true;
          renderMusicTracks();
          syncMusicControls();
          applyMusicSettings(false);
          showToast("Music settings saved.", "success");
        } catch (error) {
          showToast(error.message || "Unable to save music settings", "error");
        } finally {
          if (button) button.disabled = false;
        }
