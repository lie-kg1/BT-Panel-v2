                <h2>Music Settings</h2>
                <p>Manage ambient audio and playback preferences for your panel.</p>
              </div>
              <span class="music-status" id="musicStatus">Disabled</span>
            </div>
            <div class="card-body">
              <div class="music-studio-grid">
                <section class="music-panel" aria-labelledby="music-library-title">
                  <div class="music-panel-heading">
                    <div>
                      <h3 id="music-library-title">Track library</h3>
                      <p>Upload a local audio file or add a direct HTTP(S) audio URL.</p>
                    </div>
                  </div>
                  <div class="music-now-playing">
                    <div class="music-art" aria-hidden="true"><svg class="music-icon-svg" viewBox="0 0 24 24"><path d="M9 18V5l10-2v13" fill="none"></path><circle cx="6" cy="18" r="3"></circle><circle cx="16" cy="16" r="3"></circle></svg></div>
                    <div style="min-width: 0;">
                      <div class="music-now-title" id="musicNowPlaying">No track selected</div>
                      <div class="music-now-meta" id="musicNowMeta">Add a track to begin playback.</div>
                    </div>
                  </div>
                  <div class="music-player-strip" aria-label="Music player controls">
                    <button class="music-transport-btn" type="button" onclick="skipMusicTrack(-1)" aria-label="Previous track" title="Previous track"><svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 6 9 12l9 6z"></path></svg></button>
                    <button class="music-transport-btn primary" type="button" onclick="toggleMusicPlayback()" id="musicTransportPlayBtn" aria-label="Play selected track" title="Play selected track"><svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"></path></svg></button>
                    <button class="music-transport-btn" type="button" onclick="skipMusicTrack(1)" aria-label="Next track" title="Next track"><svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6v12l9-6zM18 5v14"></path></svg></button>
                    <button class="music-transport-btn" type="button" onclick="toggleMusicMute()" id="musicMuteBtn" aria-label="Mute music" title="Mute music"><svg class="music-icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4z"></path><path d="m17 9 4 6m0-6-4 6"></path></svg></button>
                    <div class="music-progress-group">
                      <input class="music-progress" id="musicSeekRange" type="range" min="0" max="0" step="0.1" value="0" disabled oninput="seekMusicTrack(this.value)" aria-label="Track progress" />
                      <div class="music-time" aria-live="polite"><span id="musicCurrentTime">0:00</span><span>/</span><span id="musicDuration">0:00</span></div>
                    </div>
                  </div>
                  <div class="music-track-list" id="musicTrackList" aria-live="polite">
                    <div class="music-empty">No music tracks yet.</div>
                  </div>
                  <div class="music-add-row" data-admin-only-music>
                    <input class="input" id="musicTrackName" type="text" maxlength="120" placeholder="Track name" />
                    <input class="input" id="musicTrackUrl" type="url" maxlength="1000" placeholder="https://example.com/ambient.mp3" />
                    <button class="btn btn-primary" type="button" onclick="addExternalMusicTrack()">Add URL</button>
                  </div>
                  <div class="music-file-row" data-admin-only-music>
                    <input type="file" id="musicFileInput" accept="audio/*,.mp3,.wav,.ogg,.oga,.opus,.webm,.aac,.flac,.m4a" hidden onchange="uploadMusicTrack(this.files[0])" />
                    <button class="btn btn-ghost" type="button" onclick="document.getElementById('musicFileInput').click()">Upload audio</button>
                    <button class="btn btn-ghost" type="button" onclick="toggleMusicPlayback()" id="musicPlayBtn">Play selected</button>
                  </div>
                </section>

                <section class="music-panel music-preferences-panel" aria-labelledby="music-preferences-title">
