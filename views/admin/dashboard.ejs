                    <input
                      type="url"
                      id="externalBackgroundUrl"
                      class="input"
                      placeholder="https://images.unsplash.com/..."
                      autocomplete="off"
                      spellcheck="false"
                    />
                    <button class="btn btn-primary external-apply-btn" type="button" onclick="applyExternalUrl()">
                      Apply URL
                    </button>
                  </div>
                  <div class="form-hint">Use a direct HTTPS image or video URL, then click Apply URL.</div>
                </div>

                <div class="form-group visibility-settings">
                  <label class="form-label-large">Navigation Visibility</label>
                  <div class="form-hint">Choose which navigation items are shown to users.</div>
                  <label class="visibility-option">
                    <input
                      type="checkbox"
                      id="showTeamToggle"
                      checked
                      onchange="updateNavigationSetting('showTeam', this.checked)"
