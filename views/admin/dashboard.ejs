      /* ── Pterodactyl: servers view ─────────────────────────────────── */
      let serversList = [];
      let serversLoading = false;
      let serversViewActive = false;
      let serversResourcesTimer = null;
      const serverResourceCache = new Map();

      function initServersView() {
        serversViewActive = true;
        refreshServers();
        if (serversResourcesTimer) clearInterval(serversResourcesTimer);
        serversResourcesTimer = setInterval(refreshServerResources, 5000);
      }

      function teardownServersView() {
        serversViewActive = false;
        if (serversResourcesTimer) {
          clearInterval(serversResourcesTimer);
          serversResourcesTimer = null;
        }
      }

      async function refreshServers() {
        if (serversLoading) return;
        serversLoading = true;
        const button = document.getElementById("serversRefreshBtn");
        if (button) button.disabled = true;
        try {
          const response = await apiFetch("/api/pterodactyl/servers");
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Unable to load servers");
          serversList = Array.isArray(result.servers) ? result.servers : [];
          pterodactylConfigured = true;
          renderServers();
          refreshServerResources();
        } catch (error) {
          serversList = [];
          renderServersError(error.message || "Unable to load servers");
        } finally {
          serversLoading = false;
          if (button) button.disabled = false;
        }
      }

      function renderServersError(message) {
        const grid = document.getElementById("serversGrid");
        const empty = document.getElementById("serversEmpty");
        const emptyMsg = document.getElementById("serversEmptyMessage");
        const cta = document.getElementById("serversEmptyCta");
        if (grid) grid.innerHTML = "";
        if (empty) empty.style.display = "block";
        if (emptyMsg) emptyMsg.textContent = message;
        if (cta) cta.style.display = isAdmin() ? "inline-block" : "none";
      }

      function renderServers() {
        const grid = document.getElementById("serversGrid");
        const empty = document.getElementById("serversEmpty");
        if (!grid) return;
        if (!serversList.length) {
          renderServersError("This Pterodactyl account has no servers.");
          return;
        }
        if (empty) empty.style.display = "none";
        grid.innerHTML = serversList
          .map((server) => {
            const res = serverResourceCache.get(server.identifier);
            const state = res ? res.state : "unknown";
            const statusClass = `status-${String(state).replace(/[^a-z]/g, "") || "unknown"}`;
            const memPct = res && res.memoryLimitBytes ? Math.min(100, (res.memoryBytes / res.memoryLimitBytes) * 100) : 0;
            const diskPct = res && server.limits && server.limits.disk ? Math.min(100, (res.diskBytes / (server.limits.disk * 1024 * 1024)) * 100) : 0;
            const cpuVal = res && typeof res.cpuAbsolute === "number" ? res.cpuAbsolute.toFixed(1) : "0.0";
            const cpuLimit = server.limits && server.limits.cpu ? server.limits.cpu : 100;
            const cpuPct = Math.min(100, (Number(cpuVal) / cpuLimit) * 100);
            const running = state === "running";
            const offline = state === "offline";
            return `
              <div class="server-card" data-server-id="${escapeAttr(server.identifier)}">
                <div class="server-card-head">
                  <div>
                    <div class="server-card-name">${escapeHtml(server.name || "Unnamed server")}</div>
                    <div class="server-card-node">${escapeHtml(server.node || "")}${server.suspended ? " · suspended" : ""}</div>
                  </div>
                  <span class="server-status ${statusClass}"><span class="status-dot"></span>${escapeHtml(state)}</span>
                </div>
                <div class="server-metrics">
                  <div class="server-metric">
                    <span>CPU</span>
                    <div class="metric-track"><div class="metric-fill" data-metric="cpu" style="width: ${cpuPct}%"></div></div>
                    <span class="metric-value" data-metric-value="cpu">${cpuVal}%</span>
                  </div>
                  <div class="server-metric">
                    <span>RAM</span>
                    <div class="metric-track"><div class="metric-fill" data-metric="memory" style="width: ${memPct}%"></div></div>
                    <span class="metric-value" data-metric-value="memory">${formatBytes(res ? res.memoryBytes : 0)}</span>
                  </div>
                  <div class="server-metric">
                    <span>Disk</span>
                    <div class="metric-track"><div class="metric-fill" data-metric="disk" style="width: ${diskPct}%"></div></div>
                    <span class="metric-value" data-metric-value="disk">${formatBytes(res ? res.diskBytes : 0)}</span>
                  </div>
                </div>
                <div class="server-card-actions">
                  <button class="server-btn server-btn-start" type="button" ${running ? "disabled" : ""} onclick="sendPowerSignal('${escapeAttr(server.identifier)}', 'start')">Start</button>
                  <button class="server-btn server-btn-stop" type="button" ${offline ? "disabled" : ""} onclick="sendPowerSignal('${escapeAttr(server.identifier)}', 'stop')">Stop</button>
                  <button class="server-btn" type="button" ${offline ? "disabled" : ""} onclick="sendPowerSignal('${escapeAttr(server.identifier)}', 'restart')">Restart</button>
                  <button class="server-btn server-btn-kill" type="button" ${offline ? "disabled" : ""} onclick="sendPowerSignal('${escapeAttr(server.identifier)}', 'kill')">Kill</button>
                  <button class="server-btn server-btn-console" type="button" onclick="openServerConsole('${escapeAttr(server.identifier)}')">Console</button>
                </div>
              </div>`;
          })
          .join("");
      }

      function updateServerCardMetrics(identifier, res) {
        const card = document.querySelector(`.server-card[data-server-id="${CSS.escape(identifier)}"]`);
        if (!card) return;
        const server = serversList.find((s) => s.identifier === identifier) || {};
        const limits = server.limits || {};
        const state = res.state || "unknown";
        const statusEl = card.querySelector(".server-status");
        if (statusEl) {
          statusEl.className = `server-status status-${String(state).replace(/[^a-z]/g, "") || "unknown"}`;
          statusEl.innerHTML = `<span class="status-dot"></span>${escapeHtml(state)}`;
        }
        const setMetric = (name, pct, text) => {
          const fill = card.querySelector(`[data-metric="${name}"]`);
          const value = card.querySelector(`[data-metric-value="${name}"]`);
          if (fill) fill.style.width = `${Math.max(0, Math.min(100, pct))}%`;
          if (value) value.textContent = text;
        };
        const cpuVal = typeof res.cpuAbsolute === "number" ? res.cpuAbsolute : 0;
        const cpuLimit = limits.cpu || 100;
        setMetric("cpu", (cpuVal / cpuLimit) * 100, `${cpuVal.toFixed(1)}%`);
        const memPct = res.memoryLimitBytes ? (res.memoryBytes / res.memoryLimitBytes) * 100 : 0;
        setMetric("memory", memPct, formatBytes(res.memoryBytes || 0));
        const diskLimitBytes = (limits.disk || 0) * 1024 * 1024;
        setMetric("disk", diskLimitBytes ? ((res.diskBytes || 0) / diskLimitBytes) * 100 : 0, formatBytes(res.diskBytes || 0));
        const running = state === "running";
        const offline = state === "offline";
        card.querySelectorAll(".server-card-actions .server-btn").forEach((btn) => {
          const label = btn.textContent.trim().toLowerCase();
          if (label === "start") btn.disabled = running;
          else if (label === "stop" || label === "restart" || label === "kill") btn.disabled = offline;
        });
      }

      async function refreshServerResources() {
        if (!serversViewActive || !serversList.length) return;
        await Promise.all(
          serversList.map(async (server) => {
            try {
              const response = await apiFetch(`/api/pterodactyl/servers/${encodeURIComponent(server.identifier)}/resources`);
              const result = await response.json();
              if (!response.ok || !result.success) return;
              serverResourceCache.set(server.identifier, result.resources);
              updateServerCardMetrics(server.identifier, result.resources);
            } catch (_) {
              /* keep previous values on transient failures */
            }
          })
        );
      }

      async function sendPowerSignal(identifier, signal) {
        try {
          const response = await apiFetch(`/api/pterodactyl/servers/${encodeURIComponent(identifier)}/power`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ signal }),
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Power action failed");
          showToast(result.message || `Power signal "${signal}" sent.`, "success");
          setTimeout(refreshServerResources, 1200);
          setTimeout(refreshServerResources, 4000);
        } catch (error) {
          showToast(error.message || "Power action failed", "error");
        }
      }

      /* ── Pterodactyl: console ──────────────────────────────────────── */
      let consoleSocket = null;
      let consoleTerm = null;
      let consoleFit = null;
      let consoleServerId = null;

      async function openServerConsole(identifier) {
        const server = serversList.find((s) => s.identifier === identifier);
        try {
          const response = await apiFetch(`/api/pterodactyl/servers/${encodeURIComponent(identifier)}/websocket`);
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || "Console unavailable");
          connectConsoleSocket(identifier, server, result.websocket.socket, result.websocket.token);
        } catch (error) {
          showToast(error.message || "Console unavailable", "error");
        }
      }

      function connectConsoleSocket(identifier, server, socketUrl, token) {
        closeConsoleSocket();
        consoleServerId = identifier;
        document.getElementById("consoleServerName").textContent = server ? server.name : identifier;
        document.getElementById("consoleServerMeta").textContent = `Server ${identifier}`;
        document.getElementById("consoleOverlay").classList.add("open");
        document.getElementById("consoleDrawer").classList.add("open");
        const host = document.getElementById("consoleTerminalHost");
        host.innerHTML = "";
        if (window.Terminal) {
          consoleTerm = new Terminal({
            convertEol: true,
            fontSize: 13,
            fontFamily: "SFMono-Regular, Consolas, monospace",
            theme: { background: "#0a0a0d", foreground: "#e7e9f0", cursor: "#e7e9f0" },
          });
          if (window.FitAddon && window.FitAddon.FitAddon) {
            consoleFit = new FitAddon.FitAddon();
            consoleTerm.loadAddon(consoleFit);
          }
          consoleTerm.open(host);
          if (consoleFit) setTimeout(() => consoleFit.fit(), 60);
          consoleTerm.writeln("\x1b[2mConnecting to console…\x1b[0m");
        }
        try {
          consoleSocket = new WebSocket(socketUrl);
        } catch (_) {
          if (consoleTerm) consoleTerm.writeln("\x1b[31mInvalid console socket URL.\x1b[0m");
          return;
        }
        consoleSocket.onopen = () => {
          consoleSocket.send(JSON.stringify({ event: "auth", args: [token] }));
        };
        consoleSocket.onmessage = (event) => {
          let payload;
          try { payload = JSON.parse(event.data); } catch (_) { return; }
          if (payload.event === "auth success" && consoleTerm) consoleTerm.writeln("\x1b[32m✓ Console authenticated\x1b[0m");
          if (payload.event === "token expiring") {
            apiFetch(`/api/pterodactyl/servers/${encodeURIComponent(identifier)}/websocket`)
              .then((r) => r.json())
              .then((r) => {
                if (r && r.success && r.websocket) consoleSocket.send(JSON.stringify({ event: "auth", args: [r.websocket.token] }));
              })
              .catch(() => {});
          }
          if (payload.event === "console output" && consoleTerm && payload.args) consoleTerm.writeln(String(payload.args[0] || ""));
          if (payload.event === "status" && consoleTerm && payload.args) consoleTerm.writeln(`\x1b[2m[status] ${payload.args[0]}\x1b[0m`);
        };
        consoleSocket.onerror = () => {
          if (consoleTerm) consoleTerm.writeln("\x1b[31mConsole connection error.\x1b[0m");
        };
        consoleSocket.onclose = () => {
          if (consoleTerm) consoleTerm.writeln("\x1b[2mConsole disconnected.\x1b[0m");
        };
      }

      function closeConsoleSocket() {
        if (consoleSocket) {
          try { consoleSocket.close(); } catch (_) {}
          consoleSocket = null;
        }
      }

      function closeServerConsole() {
        closeConsoleSocket();
        document.getElementById("consoleOverlay").classList.remove("open");
        document.getElementById("consoleDrawer").classList.remove("open");
        consoleServerId = null;
      }

      function sendConsoleCommand() {
        const input = document.getElementById("consoleCommandInput");
        const command = input ? input.value.trim() : "";
        if (!command || !consoleServerId) return;
        if (consoleSocket && consoleSocket.readyState === WebSocket.OPEN) {
          consoleSocket.send(JSON.stringify({ event: "send command", args: [command] }));
          input.value = "";
          return;
        }
        apiFetch(`/api/pterodactyl/servers/${encodeURIComponent(consoleServerId)}/command`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ command }),
        })
          .then((r) => r.json())
          .then((r) => {
            if (r && r.success) {
              showToast("Command sent.", "success");
              input.value = "";
            } else {
              showToast((r && r.message) || "Command failed", "error");
            }
          })
          .catch(() => showToast("Command failed", "error"));
      }

      document.getElementById("consoleCommandInput").addEventListener("keydown", (event) => {
        if (event.key === "Enter") sendConsoleCommand();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && document.getElementById("consoleDrawer").classList.contains("open")) closeServerConsole();
      });

      function formatBytes(bytes) {
        const value = Number(bytes) || 0;
        if (value <= 0) return "0 MB";
        const units = ["B", "KB", "MB", "GB", "TB"];
        const index = Math.min(units.length - 1, Math.floor(Math.log(value) / Math.log(1024)));
        const sized = value / Math.pow(1024, index);
        return `${sized >= 100 ? Math.round(sized) : sized.toFixed(1)} ${units[index]}`;
      }

      function escapeHtml(value) {
        return String(value == null ? "" : value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#96;");
      }

      window.addEventListener("popstate", () => switchView(viewFromPathname(), false));

      function toggleHeaderDropdown() {
        const dd = document.getElementById("headerDropdown");
        const user = document.getElementById("headerUser");
        const isActive = dd.classList.contains("active");
        dd.classList.toggle("active", !isActive);
        user.classList.toggle("active", !isActive);
      }

      const MOBILE_SIDEBAR_BREAKPOINT = 820;

      function setSidebarCollapsed(collapsed) {
        const sidebar = document.querySelector(".sidebar");
        const button = document.getElementById("sidebarCollapseBtn");
        if (!sidebar || !button) return;
        sidebar.classList.toggle("sidebar-collapsed", collapsed);
        button.setAttribute("aria-pressed", String(collapsed));
        button.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
        button.title = collapsed ? "Expand sidebar" : "Collapse sidebar";
      }

      function toggleSidebarCollapse() {
        const sidebar = document.querySelector(".sidebar");
        if (!sidebar) return;
        if (window.innerWidth <= MOBILE_SIDEBAR_BREAKPOINT) {
          toggleMobileSidebar();
          return;
        }
        setSidebarCollapsed(!sidebar.classList.contains("sidebar-collapsed"));
      }

      function syncSidebarCollapse() {
        const sidebar = document.querySelector(".sidebar");
        if (!sidebar) return;
        if (window.innerWidth <= MOBILE_SIDEBAR_BREAKPOINT) {
          sidebar.classList.remove("sidebar-collapsed");
          return;
        }
        setSidebarCollapsed(false);
      }

      function setMobileSidebarOpen(open) {
        const sidebar = document.querySelector(".sidebar");
        const backdrop = document.getElementById("mobileSidebarBackdrop");
        if (!sidebar) return;
        sidebar.classList.toggle("mobile-open", open);
        backdrop?.classList.toggle("active", open);
        document.body.classList.toggle("mobile-sidebar-open", open);
        backdrop?.setAttribute("aria-hidden", String(!open));
      }

      function toggleMobileSidebar() {
        const sidebar = document.querySelector(".sidebar");
        if (!sidebar) return;
        setMobileSidebarOpen(!sidebar.classList.contains("mobile-open"));
      }

      window.addEventListener("resize", syncSidebarCollapse);
      syncSidebarCollapse();

      // Close dropdown when clicking outside
      document.addEventListener("click", (e) => {
        const user = document.getElementById("headerUser");
        const dd = document.getElementById("headerDropdown");
        if (user && dd && !user.contains(e.target)) {
          dd.classList.remove("active");
          user.classList.remove("active");
        }
      });

      /* ═══════════════════════════════════════════════════════════════
       CURRENT USER
       ═══════════════════════════════════════════════════════════════ */
      async function loadCurrentUser() {
        try {
          const res = await apiFetch("/api/me");
          const data = await res.json();
          if (data.success) {
            currentUser = data.user;
            // Sidebar profile
            document.getElementById("sidebarProfileName").textContent =
              escapeHtml(currentUser.username);
            const role = (currentUser.role || "member").toLowerCase();
            document.getElementById("sidebarProfileRole").textContent =
              displayRole(role);
            const avatarImg = document.getElementById("sidebarAvatarImg");
            const avatarFallback = document.getElementById(
              "sidebarAvatarFallback"
            );
            renderAvatar(avatarImg, avatarFallback, currentUser.profilePic);

            // Header user
            document.getElementById("headerUserName").textContent = escapeHtml(
              currentUser.username
            );
            document.getElementById("headerUserRole").textContent =
              displayRole(role);
            const hImg = document.getElementById("headerAvatarImg");
            const hFallback = document.getElementById("headerAvatarFallback");
            renderAvatar(hImg, hFallback, currentUser.profilePic);
            // Role-based nav visibility
            document.querySelectorAll(".admin-only").forEach((el) => {
              el.style.display = isAdmin() ? "" : "none";
            });
            // Also hide admin section labels if no admin items visible
            const adminSection = document.querySelector(
              ".nav-section-label.admin-only"
            );
            if (adminSection)
              adminSection.style.display = isAdmin() && barsSettings.showAdminStats !== false ? "" : "none";
            applyNavigationVisibility();
            applySettingsRoleVisibility();
            // Dashboard label stays as Dashboard for all
            const homeNav = document.getElementById("nav-home");
            if (homeNav) homeNav.style.display = "";
          } else {
            showToast("Session expired. Please sign in again.", "error");
            setTimeout(() => (window.location.href = "/login"), 2000);
          }
        } catch (err) {
          console.error("Failed to load user:", err);
          if (err.message !== "Unauthorized") {
            showToast("Connection error. Retrying...", "error");
          }
        }
      }

      /* ═══════════════════════════════════════════════════════════════
       THEME / SETTINGS
       ═══════════════════════════════════════════════════════════════ */
      async function loadSettings() {
        let data = {};
        const cached = localStorage.getItem("botpanel_theme");
        if (cached) {
          try {
            const parsed = JSON.parse(cached);
            data = { ...parsed };
            applyThemeToPage(data);
          } catch (e) {}
        }
        try {
          const res = await apiFetch("/api/theme");
          const json = await res.json();
          if (
            json &&
            (json.wallpaperUrl !== undefined || json.accentColor !== undefined)
          ) {
            data = { ...data, ...json };
            localStorage.setItem("botpanel_theme", JSON.stringify(data));
          }
        } catch (err) {
          console.warn("Theme API unavailable, using defaults");
        }

        themeSettings = { ...data };
        syncNavigationControls();
        applyNavigationVisibility();
        selectedWallpaperUrl = data.wallpaperUrl || "";
        const externalUrlInput = document.getElementById("externalBackgroundUrl");
        if (externalUrlInput && /^https?:\/\//i.test(selectedWallpaperUrl)) {
          externalUrlInput.value = selectedWallpaperUrl;
        }

        const blur = parseInt(data.bgBlur ?? 0, 10);
        document.getElementById("blurRange").value = blur;
        document.getElementById("blurVal").textContent = blur + "px";

        const opacity = parseInt(data.bgOpacity ?? 100, 10);
        document.getElementById("opacityRange").value = opacity;
        document.getElementById("opacityVal").textContent = opacity + "%";

        const accent = data.accentColor || "#d00000";
        document.getElementById("accentPicker").value = accent;

        const glassTint = data.glassTint || "#000000";
        document.getElementById("glassTintPicker").value = glassTint;

        const navText = data.navText || "#9da3b4";
        document.getElementById("navTextPicker").value = navText;

        const navTextActive = data.navTextActive || "#e7e9f0";
        document.getElementById("navTextActivePicker").value = navTextActive;

        const glassBlur = parseInt(data.glassBlur ?? 0, 10);
        document.getElementById("glassBlurRange").value = glassBlur;
        document.getElementById("glassBlurVal").textContent = glassBlur + "px";

        const borderRadius = parseInt(data.borderRadius ?? 10, 10);
        document.getElementById("borderRadiusRange").value = borderRadius;
        document.getElementById("borderRadiusVal").textContent =
          borderRadius + "px";

        const glassOpacity = parseInt(data.glassOpacity ?? 22, 10);
        document.getElementById("glassOpacityRange").value = glassOpacity;
        document.getElementById("glassOpacityVal").textContent =
          glassOpacity + "%";

        applyThemeToPage(data);
        document
          .getElementById("blurRange")
          .style.setProperty("--value", blur + "%");
        document
          .getElementById("opacityRange")
          .style.setProperty("--value", opacity + "%");
        document
          .getElementById("glassBlurRange")
          .style.setProperty("--value", (glassBlur / 40) * 100 + "%");
        document
          .getElementById("borderRadiusRange")
          .style.setProperty("--value", (borderRadius / 24) * 100 + "%");
        document
          .getElementById("glassOpacityRange")
          .style.setProperty("--value", glassOpacity + "%");
        // Media management is admin-only. Do not request it before the
        // current user has been loaded, or members receive a misleading 403.
        if (isAdmin()) fetchMediaList();
      }

      function applyThemeToPage(settings) {
        const bgImg = document.getElementById("bgImage");
        const bgVid = document.getElementById("bgVideo");

        if (settings.wallpaperUrl) {
          const isVideo = /\.(mp4|webm|mov)$/i.test(settings.wallpaperUrl);
          if (isVideo) {
            bgImg.style.display = "none";
            bgVid.src = settings.wallpaperUrl;
            bgVid.style.display = "block";
            bgVid.play().catch(() => {});
          } else {
            bgVid.style.display = "none";
            bgVid.pause();
            bgVid.src = "";
            document.documentElement.style.setProperty(
              "--wallpaper-url",
              `url('${settings.wallpaperUrl}')`
            );
            bgImg.style.display = "block";
          }
        } else {
          bgImg.style.display = "none";
          bgVid.style.display = "none";
          bgVid.pause();
          bgVid.src = "";
          document.documentElement.style.setProperty("--wallpaper-url", "none");
        }

        const blur = parseInt(settings.bgBlur ?? 0, 10);
        document.documentElement.style.setProperty("--bg-blur", blur + "px");

        const opacity = parseInt(settings.bgOpacity ?? 100, 10) / 100;
        document.documentElement.style.setProperty(
          "--bg-opacity",
          String(opacity)
        );

        const accent = settings.accentColor || "#d00000";
        document.documentElement.style.setProperty("--accent", accent);

        const glassTint = settings.glassTint || "#000000";
        const rgb = hexToRgb(glassTint);
        const glassOpacity = parseInt(settings.glassOpacity ?? 22, 10) / 100;
        document.documentElement.style.setProperty("--glass-tint", rgb);
        document.documentElement.style.setProperty(
          "--bg-sidebar",
          `rgba(${rgb}, ${0.92 * glassOpacity})`
        );
        document.documentElement.style.setProperty(
          "--bg-card",
          `rgba(${rgb}, ${0.45 * glassOpacity})`
        );
        document.documentElement.style.setProperty(
          "--bg-card-raised",
          `rgba(${rgb}, ${0.55 * glassOpacity})`
        );
        document.documentElement.style.setProperty(
          "--bg-console",
          `rgba(${rgb}, ${0.5 * glassOpacity})`
        );

        const navText = settings.navText || "#9da3b4";
        document.documentElement.style.setProperty("--nav-text", navText);

        const navTextActive = settings.navTextActive || "#e7e9f0";
        document.documentElement.style.setProperty(
          "--nav-text-active",
          navTextActive
        );

        const glassBlur = parseInt(settings.glassBlur ?? 0, 10);
        document.documentElement.style.setProperty(
          "--glass-blur",
          glassBlur + "px"
        );

        const glassSaturate = parseInt(settings.glassSaturate ?? 180, 10);
        document.documentElement.style.setProperty(
          "--glass-saturate",
          glassSaturate + "%"
        );

        const borderRadius = parseInt(settings.borderRadius ?? 10, 10);
        document.documentElement.style.setProperty(
          "--panel-radius",
          borderRadius + "px"
        );

        document.documentElement.style.setProperty(
          "--glass-opacity",
          String(glassOpacity)
        );

      }

      function updateBlur(value) {
        document.getElementById("blurVal").textContent = value + "px";
        document.documentElement.style.setProperty("--bg-blur", value + "px");
        themeSettings.bgBlur = parseInt(value, 10);
        const slider = document.getElementById("blurRange");
        slider.style.setProperty("--value", value + "%");
      }

      function updateOpacity(value) {
        document.getElementById("opacityVal").textContent = value + "%";
        document.documentElement.style.setProperty("--bg-opacity", value / 100);
        themeSettings.bgOpacity = parseInt(value, 10);
        const slider = document.getElementById("opacityRange");
        slider.style.setProperty("--value", value + "%");
      }

      function updateAccent(value) {
        document.documentElement.style.setProperty("--accent", value);
        themeSettings.accentColor = value;
      }

      function hexToRgb(hex) {
        const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
        return result
          ? `${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(
              result[3],
              16
            )}`
          : "12, 14, 28";
      }

      function updateGlassTint(value) {
        document.documentElement.style.setProperty(
          "--glass-tint",
          hexToRgb(value)
        );
        themeSettings.glassTint = value;
      }

      function updateNavText(value) {
        document.documentElement.style.setProperty("--nav-text", value);
        themeSettings.navText = value;
      }

      function updateNavTextActive(value) {
        document.documentElement.style.setProperty("--nav-text-active", value);
        themeSettings.navTextActive = value;
      }

      function updateGlassOpacity(value) {
        const numericValue = Math.max(0, Math.min(100, parseInt(value, 10) || 0));
        const opacity = numericValue / 100;
        document.getElementById("glassOpacityVal").textContent = numericValue + "%";
        document.documentElement.style.setProperty("--glass-opacity", opacity);
        const rgb = hexToRgb(themeSettings.glassTint || "#000000");
        document.documentElement.style.setProperty("--bg-sidebar", `rgba(${rgb}, ${0.92 * opacity})`);
        document.documentElement.style.setProperty("--bg-card", `rgba(${rgb}, ${0.45 * opacity})`);
        document.documentElement.style.setProperty("--bg-card-raised", `rgba(${rgb}, ${0.55 * opacity})`);
        document.documentElement.style.setProperty("--bg-console", `rgba(${rgb}, ${0.5 * opacity})`);
        themeSettings.glassOpacity = numericValue;
        const slider = document.getElementById("glassOpacityRange");
        if (slider) {
          slider.value = numericValue;
          slider.style.setProperty("--value", numericValue + "%");
        }
      }

      function updateGlassBlur(value) {
        document.getElementById("glassBlurVal").textContent = value + "px";
        document.documentElement.style.setProperty(
          "--glass-blur",
          value + "px"
        );
        themeSettings.glassBlur = parseInt(value, 10);
        const slider = document.getElementById("glassBlurRange");
        if (slider)
          slider.style.setProperty("--value", (value / 40) * 100 + "%");
      }

      function updateBorderRadius(value) {
        document.getElementById("borderRadiusVal").textContent = value + "px";
        document.documentElement.style.setProperty(
          "--panel-radius",
          value + "px"
        );
        themeSettings.borderRadius = parseInt(value, 10);
        const slider = document.getElementById("borderRadiusRange");
        if (slider)
          slider.style.setProperty("--value", (value / 24) * 100 + "%");
      }

      async function saveTheme() {
        if (isSavingTheme) return;
        isSavingTheme = true;
        const btn = document.getElementById("saveThemeBtn");
        btn.classList.add("loading");
        btn.disabled = true;
        const payload = {
          wallpaperUrl: selectedWallpaperUrl,
          bgBlur:
            themeSettings.bgBlur ??
            parseInt(document.getElementById("blurRange").value, 10),
          bgOpacity:
            themeSettings.bgOpacity ??
            parseInt(document.getElementById("opacityRange").value, 10),
          accentColor:
            themeSettings.accentColor ??
            document.getElementById("accentPicker").value,
          glassTint:
            themeSettings.glassTint ??
            document.getElementById("glassTintPicker").value,
          navText:
            themeSettings.navText ??
            document.getElementById("navTextPicker").value,
          navTextActive:
            themeSettings.navTextActive ??
            document.getElementById("navTextActivePicker").value,
          glassBlur:
            themeSettings.glassBlur ??
            parseInt(document.getElementById("glassBlurRange").value, 10),
          glassSaturate: 180,
          borderRadius:
            themeSettings.borderRadius ??
            parseInt(document.getElementById("borderRadiusRange").value, 10),
          glassOpacity:
            themeSettings.glassOpacity ??
            parseInt(document.getElementById("glassOpacityRange").value, 10),
          showTeam: themeSettings.showTeam !== false,
        };

        try {
          const res = await apiFetch("/api/theme", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            const savedTheme = data.theme || payload;
            themeSettings = { ...themeSettings, ...savedTheme };
            selectedWallpaperUrl = savedTheme.wallpaperUrl || "";
            localStorage.setItem("botpanel_theme", JSON.stringify(savedTheme));
            applyThemeToPage(savedTheme);
            showToast("Theme saved successfully", "success");
          } else {
            showToast(data.message || "Failed to save theme", "error");
          }
        } catch (err) {
          showToast("Server connection error", "error");
        } finally {
          isSavingTheme = false;
          btn.classList.remove("loading");
          btn.disabled = false;
        }
      }

      function resetTheme() {
        selectedWallpaperUrl = "";
        themeSettings = { ...themeSettings, wallpaperUrl: "" };
        const externalUrlInput = document.getElementById("externalBackgroundUrl");
        if (externalUrlInput) externalUrlInput.value = "";
        document.getElementById("blurRange").value = 0;
        document.getElementById("opacityRange").value = 100;
        document.getElementById("accentPicker").value = "#d00000";
        document.getElementById("glassTintPicker").value = "#000000";
        document.getElementById("navTextPicker").value = "#9da3b4";
        document.getElementById("navTextActivePicker").value = "#e7e9f0";
        document.getElementById("glassBlurRange").value = 0;
        document.getElementById("borderRadiusRange").value = 24;
        document.getElementById("glassOpacityRange").value = 22;
        themeSettings.showTeam = true;
        syncNavigationControls();
        applyNavigationVisibility();
        updateBlur(0);
        updateOpacity(100);
        updateAccent("#d00000");
        updateGlassTint("#000000");
        updateNavText("#9da3b4");
        updateNavTextActive("#e7e9f0");
        updateGlassBlur(0);
        updateBorderRadius(24);
        updateGlassOpacity(22);
        applyThemeToPage(themeSettings);
        showToast("Theme reset. Click Save to persist.", "success");
      }

      /* ═══════════════════════════════════════════════════════════════
       HOME DASHBOARD
       ═══════════════════════════════════════════════════════════════ */
      async function renderHome() {
        if (!currentUser) return;
        document.getElementById("dash-username").textContent = escapeHtml(
          currentUser.username
        );
        const role = currentUser.role || "member";
        document.getElementById("dash-role").innerHTML = roleBadge(role);
        // Show admin stats for owner/admin
        const adminStats = document.getElementById("home-admin-stats");
        if (adminStats) {
          if (isAdmin()) {
            adminStats.style.display = barsSettings.showAdminStats !== false ? "block" : "none";
            try {
              const res = await apiFetch("/api/users");
              const data = await res.json();
              const count = data.success && data.users ? data.users.length : 0;
              document.getElementById("admin-user-count").textContent = count;
            } catch (err) {
              document.getElementById("admin-user-count").textContent = "—";
            }
          } else {
            adminStats.style.display = "none";
          }
        }
      }

      /* ═══════════════════════════════════════════════════════════════
       MEDIA UPLOAD / GALLERY
       ═══════════════════════════════════════════════════════════════ */
      function handleDragOver(e) {
        e.preventDefault();
        e.currentTarget.classList.add("dragover");
      }

      function handleDragLeave(e) {
        e.currentTarget.classList.remove("dragover");
      }

      function handleDrop(e) {
        e.preventDefault();
        e.currentTarget.classList.remove("dragover");
        const files = e.dataTransfer.files;
        if (files.length > 0) uploadMedia(files[0]);
      }

      async function uploadMedia(file) {
        if (!file) return;
        const zone = document.getElementById("mediaDropZone");
        zone.classList.add("upload-zone-uploading");

        const form = new FormData();
        form.append("file", file);

        try {
          const res = await apiFetch("/api/media/upload", {
            method: "POST",
            body: form,
          });
          const data = await res.json();
          if (data.success) {
            showToast("Media uploaded", "success");
            fetchMediaList();
          } else {
            showToast(data.message || "Upload failed", "error");
          }
        } catch (err) {
          showToast("Server connection error", "error");
        } finally {
          zone.classList.remove("upload-zone-uploading");
          document.getElementById("mediaFileInput").value = "";
        }
      }

      async function fetchMediaList() {
        try {
          const res = await apiFetch("/api/media/list");
          const data = await res.json();
          const gallery = document.getElementById("mediaGallery");
          gallery.innerHTML = "";

          if (!data.success || !data.files || data.files.length === 0) {
            gallery.innerHTML =
              '<div class="media-empty">No media uploaded yet</div>';
            return;
          }

          data.files.forEach((file) => {
            const isVideo = file.type === "video";
            const isSelected =
              selectedWallpaperUrl === CONFIG.backgroundBasePath + file.name;
            const item = document.createElement("div");
            item.className = "media-item" + (isSelected ? " selected" : "");
            item.title = file.name;
            item.setAttribute("role", "button");
            item.setAttribute("tabindex", "0");
            item.setAttribute("aria-label", `Select ${file.name}`);

            if (isVideo) {
              item.innerHTML = '<div class="media-item-video">Video</div>';
            } else {
              const mediaUrl = `${CONFIG.backgroundBasePath}${encodeURIComponent(file.name)}`;
              item.innerHTML = `<img src="${mediaUrl}" alt="${escapeHtml(
                file.name
              )}" loading="lazy" /><span class="media-item-label">${escapeHtml(
                file.name
              )}</span>`;
              const preview = item.querySelector("img");
              preview.addEventListener("error", () => {
                preview.remove();
                item.classList.add("media-item-unavailable");
                const label = item.querySelector(".media-item-label");
                if (label) label.textContent = "Preview unavailable";
              }, { once: true });
            }

            const delBtn = document.createElement("button");
            delBtn.className = "media-delete";
            delBtn.innerHTML = "&times;";
            delBtn.title = "Delete";
            delBtn.setAttribute("aria-label", `Delete ${file.name}`);
            delBtn.onclick = (e) => {
              e.stopPropagation();
              deleteMedia(file.name);
            };
            item.appendChild(delBtn);

            item.onclick = () => selectMedia(file.name);
            item.onkeydown = (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                selectMedia(file.name);
              }
            };

            gallery.appendChild(item);
          });
        } catch (err) {
          console.error("Failed to load media:", err);
          document.getElementById("mediaGallery").innerHTML =
            '<div class="media-empty">Failed to load media</div>';
        }
      }

      function selectMedia(filename) {
        selectedWallpaperUrl = CONFIG.backgroundBasePath + filename;
        themeSettings = { ...themeSettings, wallpaperUrl: selectedWallpaperUrl };
        const externalUrlInput = document.getElementById("externalBackgroundUrl");
        if (externalUrlInput) externalUrlInput.value = "";
        applyThemeToPage({ wallpaperUrl: selectedWallpaperUrl });
        fetchMediaList(); // Re-render to update selection border
        showToast("Wallpaper selected", "success");
      }

      function applyExternalUrl() {
        const input = document.getElementById("externalBackgroundUrl");
        const value = (input?.value || "").trim();
        if (!/^https?:\/\//i.test(value)) {
          showToast("Enter a valid HTTP or HTTPS URL", "error");
          input?.focus();
          return;
        }
        selectedWallpaperUrl = value;
        themeSettings = { ...themeSettings, wallpaperUrl: selectedWallpaperUrl };
        document.querySelectorAll(".media-item.selected").forEach((item) => item.classList.remove("selected"));
        applyThemeToPage({ wallpaperUrl: selectedWallpaperUrl });
        showToast("External wallpaper applied. Click Save Theme to persist.", "success");
      }

      async function deleteMedia(name) {
        if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
        try {
          const res = await apiFetch(`/api/media/${encodeURIComponent(name)}`, {
            method: "DELETE",
          });
          const data = await res.json();
          if (data.success) {
            showToast("Media deleted", "success");
            if (selectedWallpaperUrl === CONFIG.backgroundBasePath + name) {
              selectedWallpaperUrl = "";
              themeSettings = { ...themeSettings, wallpaperUrl: "" };
              applyThemeToPage(themeSettings);
            }
            fetchMediaList();
          } else {
            showToast(data.message || "Failed to delete", "error");
          }
        } catch (err) {
          showToast("Server connection error", "error");
        }
      }

      /* ═══════════════════════════════════════════════════════════════
       ACCOUNT
       ═══════════════════════════════════════════════════════════════ */
      function renderAccountInfo() {
        if (!currentUser) return;

        // Large avatar
