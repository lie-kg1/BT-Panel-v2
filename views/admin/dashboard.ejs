      async function fetchUsers({ silent = false } = {}) {
        if (!canManageUsers()) {
          if (!silent) showToast("You do not have permission to view this page.", "error");
          if (!silent) switchView("home");
          return;
        }
        const list = document.getElementById("usersList");
        if (list && !silent) list.innerHTML = '<div class="user-empty">Loading users...</div>';

        try {
          const res = await apiFetch("/api/users");
          const data = await res.json();

          if (!data.success) {
            list.innerHTML = `<div class="user-empty" style="color: var(--red);">${escapeHtml(data.message)}</div>`;
            return;
          }

          userUsers = Array.isArray(data.users) ? data.users : [];
          cachedUsers = userUsers;
          renderUsersList();
        } catch (err) {
          if (list && (!silent || userUsers.length === 0)) list.innerHTML = '<div class="user-empty" style="color: var(--red);">Failed to load users</div>';
          if (!silent && err.message !== "Unauthorized") showToast("Failed to load users", "error");
        }
      }
      let cachedUsers = [];

