      /* ═══════════════════════════════════════════════════════════════
       UTILITIES
       ═══════════════════════════════════════════════════════════════ */
      function showToast(msg, type = "") {
        const container = document.getElementById("toastContainer");
        const toast = document.createElement("div");
        toast.className = `toast ${type}`;
        toast.textContent = msg;
        container.appendChild(toast);

        // Trigger animation
        requestAnimationFrame(() => {
          requestAnimationFrame(() => toast.classList.add("show"));
        });

        setTimeout(() => {
          toast.classList.remove("show");
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

      /* ═══════════════════════════════════════════════════════════════
       API FETCH WRAPPER (handles auth errors)
       ═══════════════════════════════════════════════════════════════ */
      async function apiFetch(url, options = {}) {
        try {
          const res = await fetch(url, {
            credentials: "same-origin",
            ...options,
          });
          // Only a missing/invalid session is a session-expiry condition.
          // HTTP 403 also represents valid permission denials and must not
          // redirect an authenticated user to the login page.
          if (res.status === 401) {
            showToast("Session expired. Redirecting to login...", "error");
            setTimeout(() => (window.location.href = "/login"), 1500);
            throw new Error("Unauthorized");
          }
          return res;
        } catch (err) {
          if (err.message === "Unauthorized") throw err;
          throw err;
        }
      }

      function escapeHtml(str) {
        if (typeof str !== "string") return "";
        return str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      // Keyboard shortcuts
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const form = document.getElementById("addUserForm");
          if (form.classList.contains("visible")) {
            form.classList.remove("visible");
            document.getElementById("toggleAddUserBtn").textContent =
              "+ Add User";
          }
        }
      });

      // Clear validation on input
      document
        .getElementById("newUserUsername")
        ?.addEventListener("input", function () {
          this.classList.remove("input-error");
          document.getElementById("usernameError").classList.remove("visible");
        });
      document
        .getElementById("newUserPassword")
        ?.addEventListener("input", function () {
          this.classList.remove("input-error");
          document.getElementById("passwordError").classList.remove("visible");
        });

      /* ═══════════════════════════════════════════════════════════════
       INIT
       ═══════════════════════════════════════════════════════════════ */
      const PRESENCE_REFRESH_MS = 5000;
      let presenceRefreshInFlight = false;

      async function refreshPresence() {
        if (!currentUser || presenceRefreshInFlight || document.hidden) return;
        presenceRefreshInFlight = true;
        try {
          await apiFetch("/api/me");
          const activeView = document.querySelector(".view.active")?.id;
          if (activeView === "view-team") await fetchTeam({ silent: true });
          if (activeView === "view-users") await fetchUsers({ silent: true });
        } catch (err) {
          if (err.message !== "Unauthorized") console.warn("Presence refresh unavailable");
        } finally {
          presenceRefreshInFlight = false;
        }
      }

      loadSettings();
      loadCurrentUser().then(() => {
        switchView(viewFromPathname(), false);
        loadGeneralSettings();
        loadBarsSettings();
        loadMusicSettings();
        refreshPresence();
      });
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) refreshPresence();
      });
      // Keep this browser session marked online and refresh visible presence every five seconds.
      window.setInterval(refreshPresence, PRESENCE_REFRESH_MS);
    </script>

