                    />
                    <span class="slider-value" id="borderRadiusVal">24px</span>
                  </div>
                  <div class="form-hint">
                    Corner roundness for cards and panels (0px = sharp)
                  </div>
                </div>

                <div class="theme-actions">
                  <button
                    class="btn btn-primary"
                    id="saveThemeBtn"
                    onclick="saveTheme()"
                  >
                    <span class="btn-spinner"></span>
                    <span class="btn-text">Save Theme</span>
                  </button>
                  <button class="btn btn-ghost" onclick="resetTheme()">
                    Reset to Default
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="settings-tab-panel" id="settings-panel-wallpapers" role="tabpanel" aria-labelledby="settings-tab-wallpapers">
          <div class="card">
            <div class="card-toolbar settings-card-heading">
              <div>
                <h2>4K Wallpapers Library <span style="color: var(--text-dim); font-weight: 500;">(4kwallpapers.com)</span></h2>
                <p>Directly browse, preview, search, and apply 4K wallpapers to your web panel.</p>
