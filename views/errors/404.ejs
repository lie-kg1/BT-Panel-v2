<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found · BT Panel</title>
    <link rel="icon" type="image/svg+xml" href="/gemini-svg.svg" />
    <style>
      :root {
        color-scheme: dark;
        --red: #d00000;
        --red-bright: #f01818;
        --bg: #000;
        --panel: rgba(14, 13, 28, 0.82);
        --line: rgba(208, 0, 0, 0.38);
        --text: #f3f4f8;
        --muted: #a8adbd;
      }

      * { box-sizing: border-box; }
      html, body { min-height: 100%; margin: 0; }
      body {
        display: grid;
        place-items: center;
        overflow: hidden;
        padding: 24px;
        background:
          radial-gradient(circle at 16% 18%, rgba(208, 0, 0, 0.1), transparent 32%),
          linear-gradient(135deg, #000 0%, #080811 52%, #020204 100%);
        color: var(--text);
        font-family: "Nunito Sans", system-ui, -apple-system, sans-serif;
      }

      .not-found {
        width: min(620px, 100%);
        padding: 42px 40px 38px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(18, 16, 34, 0.88), rgba(3, 3, 9, 0.94));
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.62), inset 0 1px 0 rgba(255, 255, 255, 0.05);
        text-align: center;
      }

      .brand { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 26px; color: #fff; font-weight: 800; letter-spacing: 0.08em; }
      .brand-mark { width: 32px; height: 32px; border-radius: 9px; }
      .code { margin: 0; color: var(--red-bright); font: 900 clamp(72px, 16vw, 132px)/0.9 "IBM Plex Mono", ui-monospace, monospace; letter-spacing: -0.08em; text-shadow: 0 0 28px rgba(208, 0, 0, 0.22); }
      h1 { margin: 22px 0 10px; font-size: clamp(22px, 4vw, 32px); }
      p { margin: 0 auto 26px; max-width: 430px; color: var(--muted); line-height: 1.65; }
      a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 20px; border: 1px solid rgba(255, 95, 95, 0.42); border-radius: 9px; background: var(--red); color: #fff; font-weight: 800; text-decoration: none; box-shadow: 0 7px 24px rgba(208, 0, 0, 0.25); }
      a:hover { background: var(--red-bright); }

      @media (max-width: 520px) {
        .not-found { padding: 34px 22px 30px; border-radius: 18px; }
      }
    </style>
  </head>
  <body>
    <main class="not-found" aria-labelledby="not-found-title">
      <div class="brand"><img class="brand-mark" src="/gemini-svg.svg" alt="BT Panel logo" /> <span>BT PANEL</span></div>
      <p class="code" aria-hidden="true">404</p>
      <h1 id="not-found-title">Page not found</h1>
      <p>The page you requested does not exist or may have moved. Return to the BT Panel home page to continue.</p>
      <a href="/">Return to panel</a>
    </main>
  </body>
</html>
